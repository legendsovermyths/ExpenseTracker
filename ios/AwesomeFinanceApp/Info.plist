    <array>
      <string>Satoshi-Light.ttf</string>
      <string>Satoshi-Regular.ttf</string>
      <string>Satoshi-Medium.ttf</string>
      <string>Satoshi-Bold.ttf</string>
      <string>Satoshi-Black.ttf</string>
    </array>
