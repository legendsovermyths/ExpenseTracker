        <array>
          <string>exp+expensify</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>expensify</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>expensifyfinance</string>
        </array>
      </dict>
    </array>
